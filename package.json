{
  "name": "apha-insights-ingestion",
  "version": "0.0.0",
  "description": "apha-insights-ingestion",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local NODE_ENV=development npm run server:debug",
    "docker:dev": "npm run dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:up:d": "docker compose up -d",
    "docker:debug": "docker compose -f compose.yaml -f compose.debug.yaml -p apha-insights-ingestion up",
    "docker:stop": "docker compose down",
    "docker:stop:v": "docker compose down -v",
    "docker:test": "docker compose -p apha-insights-ingestion-test down -v && docker compose -f compose.yaml -f compose.test.yaml -p apha-insights-ingestion-test run --build --rm apha-insights-ingestion",
    "docker:test:watch": "docker compose -p apha-insights-ingestion-test down -v && docker compose -f compose.yaml -f compose.test.yaml -f compose.test.watch.yaml -p apha-insights-ingestion-test run --build --rm apha-insights-ingestion",
    "local-s3": "sh scripts/local-s3.sh",
    "format": "prettier --write \"**/*.{cjs,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{cjs,js,json,md}\"",
    "check:all": "npm run security-audit && npm run format:check && npm run lint && npm test",
    "lint": "eslint --cache --cache-strategy content \"**/*.{cjs,js}\"",
    "lint:fix": "npm run lint -- --fix",
    "security-audit": "npm audit --audit-level=critical",
    "server:debug": "node --watch --inspect-brk=0.0.0.0 $([ -f .env ] && echo --env-file=.env) ./src",
    "server:watch": "node --watch --inspect=0.0.0.0 $([ -f .env ] && echo --env-file=.env) ./src",
    "start": "NODE_ENV=production node . --env-file-if-exists=.env",
    "test": "TZ=UTC vitest run --coverage",
    "test:watch": "TZ=UTC vitest"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@aws-sdk/credential-providers": "3.1152.0",
    "@defra/cdp-auditing": "0.6.2",
    "@defra/cdp-metrics": "0.6.1",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.1",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/hapi": "21.4.10",
    "aws4": "1.13.2",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "4.0.0",
    "joi": "18.2.9",
    "mongo-locks": "3.2.0",
    "mongodb": "7.7.0",
    "pino": "10.4.0",
    "pino-pretty": "13.2.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "9.39.5",
    "neostandard": "0.13.0",
    "npm-run-all": "4.1.5",
    "prettier": "3.9.10",
    "vitest": "4.1.11",
    "vitest-fetch-mock": "0.4.5"
  }
}
